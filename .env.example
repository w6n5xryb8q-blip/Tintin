# --- Tintin configuration ---

# LLM provider: "anthropic" (default) or "ollama"
TINTIN_LLM_PROVIDER=anthropic
TINTIN_ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# Ollama (only used if provider=ollama)
TINTIN_OLLAMA_HOST=http://localhost:11434
TINTIN_OLLAMA_MODEL=llama3.1:8b-instruct

# Public-facing name (substituted for {{PUBLIC_NAME}} in UI strings)
TINTIN_PUBLIC_NAME=Tintin

# Corpus + storage
TINTIN_CORPUS_DIR=./corpus
TINTIN_CHROMA_DIR=./data/chroma
TINTIN_SQLITE_PATH=./data/tintin.sqlite

# Snapshot date stamped in every answer footer (YYYY-MM-DD)
TINTIN_SNAPSHOT_DATE=2026-05-21

# Verification allowlist (comma-separated hostnames)
TINTIN_ALLOWED_HOSTS=irs.gov,www.irs.gov,uscode.house.gov,www.ecfr.gov,ecfr.gov

# Per-user daily token cap
TINTIN_DAILY_TOKEN_CAP=200000

# SSO (OIDC) — Google Workspace as default
TINTIN_OIDC_ISSUER=https://accounts.google.com
TINTIN_OIDC_CLIENT_ID=
TINTIN_OIDC_CLIENT_SECRET=
TINTIN_OIDC_REDIRECT_URI=http://localhost:8501/auth/callback
